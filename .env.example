# =============================================================================
# ALTBOTS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# JANGAN PERNAH COMMIT FILE .env KE GIT!
# =============================================================================

# --- Trading Mode ---
# "paper"  = Simulasi (default, aman, tidak pakai uang asli)
# "shadow" = Bot jalan real tapi HANYA LOG, tidak place order (untuk testing)
# "real"   = Eksekusi order nyata di Polymarket (UANG ASLI!)
TRADING_MODE=paper

# --- Wallet Credentials (Wajib untuk mode shadow/real) ---
# Private key dari Phantom Wallet (tanpa prefix 0x)
# Cara mendapatkan: Phantom → Settings → Security → Export Private Key
POLY_PRIVATE_KEY=

# Funder address (alamat proxy wallet di Polymarket)
# Cara mendapatkan: Login Polymarket → Profile → Settings → lihat "Funding Address"
POLY_FUNDER_ADDRESS=

# Signature type:
#   0 = EOA (Phantom, MetaMask, hardware wallet) ← GUNAKAN INI
#   1 = Email/Magic wallet
#   2 = Browser wallet proxy
POLY_SIGNATURE_TYPE=0

# Chain ID (137 = Polygon Mainnet, 80002 = Amoy Testnet)
POLY_CHAIN_ID=137

# --- Safety Limits ---
# Bet amount per trade dalam USD (mulai kecil!)
REAL_BET_AMOUNT=0.50

# Batas maksimal bet per trade (safety net)
MAX_BET_AMOUNT=5.00

# Stop bot jika total loss harian melebihi ini (0 = disabled/no limit)
MAX_DAILY_LOSS=10.00

# --- Polygon RPC (untuk auto-claim winnings) ---
# Default: https://polygon-rpc.com (gratis, rate-limited)
# Rekomendasi: daftar di Alchemy/Infura untuk RPC yang lebih reliable
POLYGON_RPC_URL=https://polygon-rpc.com
